---
const { current = 'home' } = Astro.props;
---

<div class="nrg-nav-wrap">
  <nav class="nrg-nav nrg-glass" aria-label="Kit navigation">
    <div class="nrg-nav__inner">
      <a class="nrg-nav__brand" href="/">
        <span class="nrg-nav__mark" aria-hidden="true"></span>
        <span class="nrg-nav__title">No Refraction</span>
      </a>
      <div class="nrg-nav__right">
        <a class="nrg-nav__link" href="/components" aria-current={current === 'components' ? 'page' : undefined}>Components</a>
        <a class="nrg-nav__link" href="/themes" aria-current={current === 'themes' ? 'page' : undefined}>Themes</a>
        <a class="nrg-nav__cta" href={current === 'home' ? '#install' : '/'}>Get CSS</a>
      </div>
    </div>
  </nav>
</div>
