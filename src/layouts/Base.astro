---
import '../../css/nrg.css';
const { title = 'Liquid Glass with No Refraction', description = 'Frosted-glass UI kit in the iOS 27 Liquid Glass vein: blur and inner highlights. No displacement maps, no IOR, no refraction.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-nrg-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#c30050" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('nrg-theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.setAttribute('data-nrg-theme', theme);
          }
          var accent = localStorage.getItem('nrg-accent');
          if (accent) document.documentElement.style.setProperty('--nrg-accent', accent);
          var hover = localStorage.getItem('nrg-accent-hover');
          if (hover) document.documentElement.style.setProperty('--nrg-accent-hover', hover);
          var soft = localStorage.getItem('nrg-accent-soft');
          if (soft) document.documentElement.style.setProperty('--nrg-accent-soft', soft);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="nrg-root">
    <slot />
    <script>
      import '../../css/nrg.js';
    </script>
  </body>
</html>
